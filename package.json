{
  "name": "xyq-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "crawl:175dt": "node crawler/175dt-crawler.mjs",
    "sync:netease": "node scripts/sync-netease-questions.mjs",
    "merge:questions": "node scripts/merge-questions.mjs --input data/raw/netease-questions.jsonl,data/raw/questions.jsonl --output data/merged/questions.jsonl",
    "build:index": "node scripts/build-index.mjs --input data/merged/questions.jsonl",
    "refresh:questions": "npm run sync:netease && npm run merge:questions && npm run build:index",
    "build:db": "node scripts/build-db.mjs",
    "sync:categories": "node scripts/sync-175dt-categories.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "idb": "^8.0.3",
    "onnxruntime-web": "1.27.0",
    "pinia": "^2.3.1",
    "vite": "^6.4.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "sql.js": "^1.14.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
